# คัดลอกเป็น .env แล้วเติมค่าจริง — ห้าม commit ไฟล์ .env

# DataForSEO — ใช้ HTTP Basic (login:password) ห้ามให้ค่านี้หลุดไปฝั่งหน้าเว็บเด็ดขาด
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_BASE_URL=https://api.dataforseo.com/v3

# ปริมาณการค้นหาของ Google Ads อัปเดตเดือนละครั้ง ยิงใหม่ทุกวันคือจ่ายเงินซ้ำเปล่าๆ
# (PLAN ข้อ 2.3) · ลดเลขนี้เมื่อไหร่ ต้นทุนขึ้นทันที
KEYFIN_CACHE_DAYS=30

DATABASE_URL=postgres://keyfin:CHANGE_ME@localhost:5432/keyfin

JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# โควตาตั้งต้น ต้องแก้หลังวัดต้นทุนจริงแล้ว (PLAN ข้อ 5, 8)
QUOTA_FREE_PER_DAY=5
QUOTA_PAID_PER_DAY=200

# ใช้ตัดสินว่า "วันนี้" คือวันไหนตอนรีเซ็ตโควตา ห้ามใช้ UTC (PLAN ข้อ 5)
KEYFIN_TZ=Asia/Bangkok
PORT=4000

# กราฟย้อนหลังกี่เดือน · 24 เดือนไม่เสียเงินเพิ่ม แต่ตอบช้าขึ้นจาก 7 เป็น 11 วินาที (PLAN ข้อ 2.9)
KEYFIN_MONTHS_BACK=24

# เพดานจริงของ DataForSEO คือ 12/นาที ตั้ง 10 ไว้กันนาฬิกาสองฝั่งไม่ตรงกัน (PLAN ข้อ 2.8)
KEYFIN_RATE_PER_MINUTE=10

# สมาชิก Free เห็นกี่แถว · ต้องบอกเสมอว่าตัดไปเท่าไหร่ (CLAUDE.md กฎข้อ 4)
KEYFIN_FREE_ROW_LIMIT=50

# ใช้แปลงค่า API เป็นบาทบนหน้าจอเท่านั้น ไม่ใช่เรตจริงแบบสด — แก้เมื่อเรตขยับเยอะ
KEYFIN_USD_THB=33

# KeywordTool.io — ทีมมีแผน Growth $188/เดือน อยู่แล้ว (100 คำขอ/วัน)
# ใช้เปรียบเทียบกับ DataForSEO ยังไม่ได้ตัดสินใจย้าย
KEYWORDTOOL_APIKEY=

# เครื่องยนต์หาคำ — labs (ค่าเริ่มต้น) หรือ google_ads
# labs ราคาราว $0.012 + $0.00012 ต่อคำ · เร็วกว่า · เพดาน 2,000/นาที · กราฟ 12 เดือน
# google_ads ราคา $0.09 คงที่ · ช้ากว่า · เพดาน 12/นาที · กราฟ 24 เดือน
KEYFIN_ENGINE=labs

# จำนวนคำสูงสุดที่ดึงต่อครั้งของ labs — คุมต้นทุนโดยตรง
# 100 คำ = $0.024 · 300 คำ = $0.048 · 700 คำ = $0.096 ซึ่งแพงกว่า google_ads แล้ว
KEYFIN_LABS_LIMIT=100
